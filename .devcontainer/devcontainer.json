{
  "name": "MPI",
  "image": "ghcr.io/mpi-lamartin/environnement:latest",
  "remoteUser": "vscode",
  "customizations": {
    "vscode": {
      "extensions": [
        "ocamllabs.ocaml-platform",
        "ms-vscode.cpptools-extension-pack",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "workbench.colorTheme": "Dark Modern",
        "ocaml.sandbox": {
          "kind": "global"
        },
        "github.copilot.enable": {
          "*": false
        }
      }
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    }
  },
  "postAttachCommand": "sh .devcontainer/install-extension.sh"
}
