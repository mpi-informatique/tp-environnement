{
  "name": "MPI personnel",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": {
      "MPI_PROFILE": "personnel"
    }
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "containerEnv": {
    "EXERCICES_LOCAL_SOURCE": "/workspaces/exercices",
    "EXERCICES_SOURCE": "/workspaces/exercices",
    "TYPST_PACKAGE_PATH": "/workspaces/exercices-prive/.typst/packages"
  },
  "remoteEnv": {
    "EXERCICES_WEB_URL": "https://${containerEnv:CODESPACE_NAME}-4321.${containerEnv:GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}"
  },
  "postCreateCommand": "python3 .devcontainer/personnel/setup.py",
  "waitFor": "postCreateCommand",
  "postAttachCommand": "python3 .devcontainer/personnel/setup.py --open-workspace",
  "forwardPorts": [3000, 4321],
  "portsAttributes": {
    "3000": { "label": "Cours", "onAutoForward": "notify" },
    "4321": { "label": "Exercices", "onAutoForward": "notify" }
  },
  "customizations": {
    "codespaces": {
      "repositories": {
        "mpi-informatique/exercices": { "permissions": { "contents": "write" } },
        "mpi-informatique/exercices-prive": { "permissions": { "contents": "write" } },
        "mpi-informatique/lib": { "permissions": { "contents": "write" } },
        "mpi-informatique/cours": { "permissions": { "contents": "write" } }
      }
    },
    "vscode": {
      "extensions": [
        "myriad-dreamin.tinymist",
        "qfortier.vscode-mpi-exercices",
        "ocamllabs.ocaml-platform",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "unifiedjs.vscode-mdx",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "ocaml.sandbox": { "kind": "global" }
      }
    }
  }
}
